{
  "id": "cg-misc",
  "title": "Champions Guild Misc",
  "description": "A grab bag of small dnd5e automations for the Champions Guild table. Currently: damage advantage, which rolls a marked character's damage of a chosen type twice and keeps the higher total.",
  "version": "0.2.0",
  "authors": [
    {
      "name": "Josh"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "cg-misc-effects",
      "label": "CG Misc - Effects",
      "path": "packs/cg-misc-effects",
      "type": "Item",
      "system": "dnd5e",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "cg-misc-tables",
      "label": "CG Misc - Tables",
      "path": "packs/cg-misc-tables",
      "type": "RollTable",
      "system": "dnd5e",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3",
          "maximum": "5.3.99"
        }
      }
    ],
    "requires": [
      {
        "id": "midi-qol",
        "type": "module",
        "compatibility": {
          "minimum": "13.0.0"
        },
        "reason": "The Dome's automated effects use midi-qol to apply damage through resistances, to create effects on actors the acting player does not own, and for the advantage/disadvantage flags dnd5e itself does not provide."
      },
      {
        "id": "dae",
        "type": "module",
        "compatibility": {},
        "reason": "Dome effects that last until the end of a turn rely on DAE special durations."
      }
    ]
  },
  "compatibility": {
    "minimum": "13",
    "verified": "13.351"
  },
  "license": "MIT",
  "readme": "https://github.com/JoshuaRogers057/cg-misc/blob/main/README.md",
  "bugs": "https://github.com/JoshuaRogers057/cg-misc/issues",
  "url": "https://github.com/JoshuaRogers057/cg-misc",
  "manifest": "https://github.com/JoshuaRogers057/cg-misc/releases/latest/download/module.json",
  "download": "https://github.com/JoshuaRogers057/cg-misc/releases/download/v0.2.0/module.zip"
}
